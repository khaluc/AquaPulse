# Sao chép thành .env rồi điền giá trị thật. Không commit .env, không đưa khoá API lên GitHub.
# File này chỉ có tên biến và ví dụ không bí mật. Để trống: dùng giá trị mặc định trong code.

# --- Database (mục 5, 13) ---
# Để trống khi chạy máy dev: khớp docker-compose.yml. Khi triển khai: chuỗi kết nối PostGIS
# (Supabase, Render Postgres có bật extension postgis).
DATABASE_URL=
# Mật khẩu cho container db trong docker-compose.yml (chỉ máy dev).
POSTGRES_PASSWORD=

# --- Model thị giác mô tả bối cảnh (mục 10). Đặt 0 để tắt hẳn. ---
AQUAPULSE_VISION_ENABLED=1
# qwen: Qwen3-VL-2B-Instruct qua Ollama (miễn phí, ảnh không rời máy chủ).
# gemini: Gemini API (trả phí, ảnh được làm mờ mặt rồi gửi sang Google).
AQUAPULSE_VISION_PROVIDER=qwen
# For Model Studio Kimi: set AQUAPULSE_VISION_PROVIDER=kimi and enable vision.
DASHSCOPE_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://ws-ojz5frpqw24ibm8d.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3-vl:2b-instruct-q8_0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Model trong backend (kế hoạch gọi là MODEL_PATH). Để trống: lấy từ ml/runs/. ---
AQUAPULSE_DETECTOR_MODEL=
AQUAPULSE_WATER_MODEL=
AQUAPULSE_FACE_MODEL=

# --- Ảnh người dân gửi. Để trống: backend/storage/photos. Trong Docker: /data/photos. ---
AQUAPULSE_PHOTO_DIR=

# --- Bản đồ (kế hoạch: MAP_TILE_URL). Để trống: OSM Humanitarian, không cần khoá. ---
MAP_TILE_URL=
MAP_ATTRIBUTION=

# --- Dữ liệu của dự án OneAquaHealth (api.enora-oah.eu, API mở, không cần khoá) ---
# Số giờ giữa hai lần tự đồng bộ; 0 = tắt. Để trống: 24.
AQUAPULSE_OAH_SYNC_HOURS=
# Đổi địa chỉ API nếu dự án chuyển máy chủ. Để trống: dùng mặc định.
AQUAPULSE_OAH_API=

# --- Tin báo chí về kênh rạch (Google News RSS) ---
# Số giờ giữa hai lần đồng bộ; 0 = tắt. Để trống: 24. Mốc thời gian: để trống là 2026-01-01.
AQUAPULSE_PRESS_SYNC_HOURS=
AQUAPULSE_PRESS_SINCE=

# --- Tài khoản xác minh (mục 16) ---
# Dạng vai_trò:mã_người:token, cách nhau bằng dấu phẩy; vai trò là volunteer hoặc expert.
# Token tối thiểu 8 ký tự, sinh ngẫu nhiên, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(24))"
AQUAPULSE_REVIEWERS=

# --- Có trong kế hoạch (mục 23) nhưng code CHƯA dùng ---
# Lưu ảnh lên Supabase Storage và đăng nhập bằng JWT chưa làm; hiện ảnh nằm trên đĩa
# (AQUAPULSE_PHOTO_DIR) và người xác minh đăng nhập bằng AQUAPULSE_REVIEWERS.
# SUPABASE_URL=
# SUPABASE_KEY=
# STORAGE_BUCKET=
# JWT_SECRET=
